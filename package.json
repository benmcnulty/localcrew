{
  "name": "localcrew",
  "version": "0.1.0",
  "description": "Local-first multi-device LLM inference orchestrator with REPL CLI and browser UI",
  "private": false,
  "type": "module",
  "license": "MIT",
  "author": "Ben",
  "repository": {
    "type": "git",
    "url": "https://github.com/benmcnulty/localcrew"
  },
  "keywords": [
    "llm",
    "orchestrator",
    "inference",
    "local-first",
    "multi-device",
    "ollama",
    "cli",
    "repl"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup:crew": "node scripts/setup-orchestrator.js",
    "setup:agent": "node scripts/setup-agent.js",
    "start": "node src/index.ts",
    "start:bun": "bun run src/index.ts",
    "start:node": "node src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test ./test/*.test.ts",
    "validate": "npm run typecheck && npm test",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
