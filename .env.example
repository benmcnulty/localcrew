# Copy this file to `.env` or `.env.local` for local overrides.
# System environment variables take precedence over these files.
#
# Recommended first-run flow:
# 1. Run `bun run setup:orchestrator`
# 2. Start Crusty with `bun run src/index.ts`
# 3. Run `node scripts/setup-node.js --orchestrator http://your-orchestrator-ip:4310` on each added device

CRUSTY_API_ENABLED=true
CRUSTY_API_BIND_HOST=0.0.0.0
CRUSTY_API_PUBLIC_HOST=127.0.0.1
CRUSTY_API_PORT=4310

# The orchestrator resource is the local device that boots first.
CRUSTY_ORCHESTRATOR_NAME=Orchestrator
CRUSTY_ORCHESTRATOR_ALIAS=orchestrator
CRUSTY_ORCHESTRATOR_LABEL=Local Orchestrator
CRUSTY_ORCHESTRATOR_TIER=top
CRUSTY_ORCHESTRATOR_BASE_URL=http://127.0.0.1:11434
CRUSTY_ORCHESTRATOR_API_STYLE=ollama
CRUSTY_ORCHESTRATOR_HOST_NAME=local-host
CRUSTY_ORCHESTRATOR_PLATFORM=darwin
CRUSTY_ORCHESTRATOR_DEFAULT_MODEL=llama3.1:8b
CRUSTY_ORCHESTRATOR_REASONING_MODEL=llama3.1:8b
# CRUSTY_ORCHESTRATOR_CODING_MODEL=qwen2.5-coder:latest
# CRUSTY_ORCHESTRATOR_TOOLS_MODEL=gemma3:4b
# CRUSTY_ORCHESTRATOR_EMBEDDING_MODEL=nomic-embed-text:latest
# CRUSTY_ORCHESTRATOR_CPU_LOGICAL_CORES=10
# CRUSTY_ORCHESTRATOR_RAM_GB=32
# CRUSTY_ORCHESTRATOR_GPU_MODEL=RTX 3060
# CRUSTY_ORCHESTRATOR_GPU_COUNT=1
# CRUSTY_ORCHESTRATOR_TOTAL_VRAM_GB=12
# CRUSTY_ORCHESTRATOR_MAX_CONTEXT_TOKENS=65536
CRUSTY_ORCHESTRATOR_ROLE=Primary orchestration resource for chat, planning, verification, and local artifact work.
CRUSTY_ORCHESTRATOR_CAPABILITIES=reasoning|planning|chat
CRUSTY_ORCHESTRATOR_NOTES=Bring this device online first.|Add the next best device through /resource or the Local UI after setup.

# Group-chat participants default to the local orchestrator resource on first run.
# These bindings, nicknames, models, and instructions can all be edited later
# through the CLI or Local UI without touching env files.
CRUSTY_DEFAULT_ENDPOINT=erin
# macOS only:
CRUSTY_SOUND_ENABLED=true
CRUSTY_ENDPOINT_ERIN_RESOURCE=orchestrator
CRUSTY_ENDPOINT_ERIN_NICKNAME=Erin
CRUSTY_ENDPOINT_ERIN_MODEL=llama3.1:8b
CRUSTY_ENDPOINT_ERIN_VOICE=allison
CRUSTY_ENDPOINT_ZORA_RESOURCE=orchestrator
CRUSTY_ENDPOINT_ZORA_NICKNAME=Zora
CRUSTY_ENDPOINT_ZORA_MODEL=llama3.1:8b
CRUSTY_ENDPOINT_ZORA_VOICE=zoe
CRUSTY_ENDPOINT_SAM_RESOURCE=orchestrator
CRUSTY_ENDPOINT_SAM_NICKNAME=Sam
CRUSTY_ENDPOINT_SAM_MODEL=llama3.1:8b
CRUSTY_ENDPOINT_SAM_VOICE=samantha
CRUSTY_ENDPOINT_PAV_RESOURCE=orchestrator
CRUSTY_ENDPOINT_PAV_NICKNAME=Pav
CRUSTY_ENDPOINT_PAV_MODEL=llama3.1:8b
CRUSTY_ENDPOINT_PAV_VOICE=evan
