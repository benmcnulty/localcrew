# Local Crew — environment configuration example
#
# Copy this file to `.env.local` for local overrides, or set variables directly
# in your shell environment. Shell environment variables take precedence over file-based ones.
#
# Recommended first-run flow:
# 1. Run `npm run setup:crew`   — interactive orchestrator bootstrap (writes .env.local)
# 2. Run `npm run start`        — start Local Crew
# 3. Run `npm run setup:agent`  — on each additional agent device
#
# IMPORTANT: Never commit API keys or real credentials to version control.
#            Use `.env.local` (gitignored) for machine-specific values.

# ─── API server ────────────────────────────────────────────────────────────────
# Required to reach the browser UI and billboard display.

LOCALCREW_API_ENABLED=true
LOCALCREW_API_BIND_HOST=0.0.0.0        # 0.0.0.0 = all interfaces (LAN access); 127.0.0.1 = localhost only
LOCALCREW_API_PUBLIC_HOST=127.0.0.1   # advertised LAN address (set to your LAN IP for multi-device use)
LOCALCREW_API_PORT=4310
LOCALCREW_API_NETWORK_SCOPE=local      # 'local' = reject non-LAN clients (recommended)

# Optional — uncomment to enable Bearer token authentication for all API endpoints
# LOCALCREW_API_TOKEN=your-secret-token

# Optional — uncomment to restrict CORS to a specific origin
# LOCALCREW_API_CORS_ORIGIN=http://192.168.1.100:4310

# ─── Remote portal ─────────────────────────────────────────────────────────────
# Optional — connect this orchestrator to a remote Port instance.
# Default: https://benlive.tv (public hosted portal)

# LOCALCREW_PORTAL_URL=https://benlive.tv

# ─── Orchestrator resource ─────────────────────────────────────────────────────
# The primary inference device. On first run, `npm run setup:crew` fills these
# values automatically from discovered local models.

LOCALCREW_ORCHESTRATOR_NAME=Orchestrator
LOCALCREW_ORCHESTRATOR_ALIAS=orchestrator
LOCALCREW_ORCHESTRATOR_LABEL=Local Crew Orchestrator
LOCALCREW_ORCHESTRATOR_TIER=top                              # top | mid
LOCALCREW_ORCHESTRATOR_BASE_URL=http://127.0.0.1:11434      # Ollama loopback
LOCALCREW_ORCHESTRATOR_API_STYLE=ollama                     # ollama | openai | anthropic

# Optional — API key env var name for OpenAI-compatible or Anthropic endpoints
# LOCALCREW_ORCHESTRATOR_API_KEY_ENV=OPENAI_API_KEY

LOCALCREW_ORCHESTRATOR_HOST_NAME=local-host
LOCALCREW_ORCHESTRATOR_PLATFORM=darwin            # darwin | linux | win32
LOCALCREW_ORCHESTRATOR_DEFAULT_MODEL=llama3.1:8b
LOCALCREW_ORCHESTRATOR_REASONING_MODEL=llama3.1:8b

# Optional — specialist model assignments
# LOCALCREW_ORCHESTRATOR_CODING_MODEL=qwen2.5-coder:latest
# LOCALCREW_ORCHESTRATOR_TOOLS_MODEL=gemma3:4b
# LOCALCREW_ORCHESTRATOR_EMBEDDING_MODEL=nomic-embed-text:latest

# Optional — hardware metadata (used for resource scoring; filled by setup script)
# LOCALCREW_ORCHESTRATOR_CPU_LOGICAL_CORES=10
# LOCALCREW_ORCHESTRATOR_RAM_GB=32
# LOCALCREW_ORCHESTRATOR_GPU_MODEL=RTX 3060
# LOCALCREW_ORCHESTRATOR_GPU_COUNT=1
# LOCALCREW_ORCHESTRATOR_TOTAL_VRAM_GB=12
# LOCALCREW_ORCHESTRATOR_MAX_CONTEXT_TOKENS=65536

LOCALCREW_ORCHESTRATOR_ROLE=Primary orchestration resource for chat, planning, verification, and local artifact work.
LOCALCREW_ORCHESTRATOR_CAPABILITIES=reasoning|planning|chat
LOCALCREW_ORCHESTRATOR_NOTES=Bring this device online first.|Add the next best device through /resource or the Local UI after setup.

# ─── Voice (macOS only) ────────────────────────────────────────────────────────

# LOCALCREW_SOUND_ENABLED=true    # uncomment on macOS to enable TTS voice playback

# ─── Default chat participants ─────────────────────────────────────────────────
# These bindings are pre-configured to use the local orchestrator as a starting
# point. All settings (nickname, model, resource binding, instructions) can be
# changed later through the CLI or browser UI without editing env files.

LOCALCREW_DEFAULT_ENDPOINT=cap

LOCALCREW_ENDPOINT_CAP_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_CAP_NICKNAME=Cap
LOCALCREW_ENDPOINT_CAP_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_CAP_VOICE=allison

LOCALCREW_ENDPOINT_VIC_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_VIC_NICKNAME=Vic
LOCALCREW_ENDPOINT_VIC_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_VIC_VOICE=zoe

LOCALCREW_ENDPOINT_MIN_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_MIN_NICKNAME=Min
LOCALCREW_ENDPOINT_MIN_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_MIN_VOICE=samantha

LOCALCREW_ENDPOINT_PAV_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_PAV_NICKNAME=Pav
LOCALCREW_ENDPOINT_PAV_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_PAV_VOICE=evan
