# Copy this file to `.env` or `.env.local` for local overrides.
# System environment variables take precedence over these files.

CRUSTY_DEFAULT_ENDPOINT=erin
CRUSTY_SOUND_ENABLED=true

# Participant endpoints used in chat/group modes.
CRUSTY_ENDPOINT_ERIN_BASE_URL=http://127.0.0.1:11434
CRUSTY_ENDPOINT_ERIN_MODEL=llama3.1:8b
CRUSTY_ENDPOINT_ERIN_VOICE=allison

CRUSTY_ENDPOINT_ZORA_BASE_URL=http://127.0.0.1:11434
CRUSTY_ENDPOINT_ZORA_MODEL=llama3.1:8b
CRUSTY_ENDPOINT_ZORA_VOICE=zoe

CRUSTY_ENDPOINT_SAM_BASE_URL=http://127.0.0.1:11434
CRUSTY_ENDPOINT_SAM_MODEL=llama3.2:1b
CRUSTY_ENDPOINT_SAM_VOICE=samantha

CRUSTY_ENDPOINT_PAV_BASE_URL=http://127.0.0.1:11434
CRUSTY_ENDPOINT_PAV_MODEL=llama3.2:1b
CRUSTY_ENDPOINT_PAV_VOICE=evan

# Resource inventory used by Erin for `/auto` delegation.
CRUSTY_RESOURCE_AIR_BASE_URL=http://127.0.0.1:11434
CRUSTY_RESOURCE_AIR_DEFAULT_MODEL=llama3.1:8b
CRUSTY_RESOURCE_AIR_REASONING_MODEL=gpt-oss:20b
CRUSTY_RESOURCE_AIR_CODING_MODEL=qwen3-coder:latest
CRUSTY_RESOURCE_AIR_TOOLS_MODEL=gemma3:4b
CRUSTY_RESOURCE_AIR_EMBEDDING_MODEL=nomic-embed-text:latest
CRUSTY_RESOURCE_AIR_NOTES=Primary orchestration node|Best default choice when task routing is ambiguous|Use the coding model for patch-heavy work and the reasoning model for verification

CRUSTY_RESOURCE_VIC_BASE_URL=http://127.0.0.1:11434
CRUSTY_RESOURCE_VIC_DEFAULT_MODEL=llama3.1:8b
CRUSTY_RESOURCE_VIC_TOOLS_MODEL=gemma3:4b
CRUSTY_RESOURCE_VIC_EMBEDDING_MODEL=nomic-embed-text:latest
CRUSTY_RESOURCE_VIC_NOTES=Top-tier external node for sustained generation|Good for heavier general generation and drafting|Tune concurrency with the benchmark scripts before raising queue pressure

CRUSTY_RESOURCE_MIN_BASE_URL=http://127.0.0.1:11434
CRUSTY_RESOURCE_MIN_DEFAULT_MODEL=llama3.2:1b
CRUSTY_RESOURCE_MIN_TOOLS_MODEL=qwen2.5:0.5b
CRUSTY_RESOURCE_MIN_EMBEDDING_MODEL=granite-embedding:latest
CRUSTY_RESOURCE_MIN_NOTES=Mid-tier helper for queue bookkeeping and indexing|Best for low-cost structured outputs and queue or memory bookkeeping|Keep prompts tight

CRUSTY_RESOURCE_PAV_BASE_URL=http://127.0.0.1:11434
CRUSTY_RESOURCE_PAV_DEFAULT_MODEL=llama3.2:3b
CRUSTY_RESOURCE_PAV_NOTES=Low-tier overflow node for small-context isolated tasks|Not suitable for heavy inference|Use sparingly for parallelism or simple alternate takes
