# Copy this file to `.env` or `.env.local` for local overrides.
# System environment variables take precedence over these files.
#
# Recommended first-run flow:
# 1. Run `npm run setup:crew`
# 2. Start Local Crew with `npm run start`
# 3. Run `npm run setup:agent` on each added agent device

LOCALCREW_API_ENABLED=true
LOCALCREW_API_BIND_HOST=0.0.0.0
LOCALCREW_API_PUBLIC_HOST=127.0.0.1
LOCALCREW_API_PORT=4310
LOCALCREW_API_NETWORK_SCOPE=local

# Remote portal (optional — set to use a self-hosted portal instance)
# LOCALCREW_PORTAL_URL=https://benlive.tv

# The orchestrator resource is the local device that boots first.
LOCALCREW_ORCHESTRATOR_NAME=Orchestrator
LOCALCREW_ORCHESTRATOR_ALIAS=orchestrator
LOCALCREW_ORCHESTRATOR_LABEL=Local Crew Orchestrator
LOCALCREW_ORCHESTRATOR_TIER=top
LOCALCREW_ORCHESTRATOR_BASE_URL=http://127.0.0.1:11434
LOCALCREW_ORCHESTRATOR_API_STYLE=ollama
# LOCALCREW_ORCHESTRATOR_API_KEY_ENV=OPENAI_API_KEY
LOCALCREW_ORCHESTRATOR_HOST_NAME=local-host
LOCALCREW_ORCHESTRATOR_PLATFORM=darwin
LOCALCREW_ORCHESTRATOR_DEFAULT_MODEL=llama3.1:8b
LOCALCREW_ORCHESTRATOR_REASONING_MODEL=llama3.1:8b
# LOCALCREW_ORCHESTRATOR_CODING_MODEL=qwen2.5-coder:latest
# LOCALCREW_ORCHESTRATOR_TOOLS_MODEL=gemma3:4b
# LOCALCREW_ORCHESTRATOR_EMBEDDING_MODEL=nomic-embed-text:latest
# LOCALCREW_ORCHESTRATOR_CPU_LOGICAL_CORES=10
# LOCALCREW_ORCHESTRATOR_RAM_GB=32
# LOCALCREW_ORCHESTRATOR_GPU_MODEL=RTX 3060
# LOCALCREW_ORCHESTRATOR_GPU_COUNT=1
# LOCALCREW_ORCHESTRATOR_TOTAL_VRAM_GB=12
# LOCALCREW_ORCHESTRATOR_MAX_CONTEXT_TOKENS=65536
LOCALCREW_ORCHESTRATOR_ROLE=Primary orchestration resource for chat, planning, verification, and local artifact work.
LOCALCREW_ORCHESTRATOR_CAPABILITIES=reasoning|planning|chat
LOCALCREW_ORCHESTRATOR_NOTES=Bring this device online first.|Add the next best device through /resource or the Local UI after setup.

# Group-chat participants default to the local orchestrator resource on first run.
# These bindings, nicknames, models, and instructions can all be edited later
# through the CLI or Local UI without touching env files.
LOCALCREW_DEFAULT_ENDPOINT=erin
# macOS only:
LOCALCREW_SOUND_ENABLED=true
LOCALCREW_ENDPOINT_ERIN_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_ERIN_NICKNAME=Erin
LOCALCREW_ENDPOINT_ERIN_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_ERIN_VOICE=allison
LOCALCREW_ENDPOINT_ZORA_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_ZORA_NICKNAME=Zora
LOCALCREW_ENDPOINT_ZORA_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_ZORA_VOICE=zoe
LOCALCREW_ENDPOINT_SAM_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_SAM_NICKNAME=Sam
LOCALCREW_ENDPOINT_SAM_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_SAM_VOICE=samantha
LOCALCREW_ENDPOINT_PAV_RESOURCE=orchestrator
LOCALCREW_ENDPOINT_PAV_NICKNAME=Pav
LOCALCREW_ENDPOINT_PAV_MODEL=llama3.1:8b
LOCALCREW_ENDPOINT_PAV_VOICE=evan
